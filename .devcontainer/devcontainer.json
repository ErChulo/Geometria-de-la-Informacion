{\n  "name": "LaTeX Book Development",\n  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",\n  "features": {\n    "ghcr.io/devcontainers/features/git:1": {}\n  },\n  "customizations": {\n    "vscode": {\n      "extensions": [\n        "James-Yu.latex-workshop"\n      ],\n      "settings": {\n        "latex-workshop.latex.recipes": [\n          {\n            "name": "pdflatex",\n            "tools": [\n              "pdflatex"\n            ]\n          },\n          {\n            "name": "pdflatex (2x)",\n            "tools": [\n              "pdflatex",\n              "pdflatex"\n            ]\n          }\n        ],\n        "latex-workshop.latex.tools": [\n          {\n            "name": "pdflatex",\n            "command": "pdflatex",\n            "args": [\n              "-interaction=nonstopmode",\n              "-file-line-error",\n              "%DOCFILE%"\n            ]\n          }\n        ],\n        "latex-workshop.view.pdf.viewer": "tab"\n      }\n    }\n  },\n  "postCreateCommand": "apt-get update && apt-get install -y texlive-full texlive-fonts-recommended texlive-fonts-extra texlive-lang-spanish"\n}