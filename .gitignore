# =============================================================================
# Companion notebooks — Geometría-IG
# =============================================================================
# Directorios + archivos que NO deben versionar:

# Cache de datos descargados (MNIST 60k opcional, etc.)
notebooks/.cache/

# Jupyter runtime / checkpoints / outputs intermedios
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python bytecache
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments (recomendado NO commitear; el lector crea el suyo)
.venv/
venv/
env/

# Editor / OS noise
.DS_Store
*.swp
*~
.idea/
.vscode/

# =============================================================================
# (El src/.gitignore ya cubre *.aux, *.log, *.pdf, etc. del build LaTeX.)
# =============================================================================
