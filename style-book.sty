% src/style-book.sty — elegant, consistent style (pdfLaTeX, oneside)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style-book}[2025/10/19 Elegant Book Style]

% ====== Base packages ======
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[spanish]{babel}
\RequirePackage{microtype}
\RequirePackage{amsmath,amssymb}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc,shadows.blur,backgrounds} % calc for coords, blur for halo, backgrounds for layering
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{tocloft}

% ====== Typefaces ======
% Text: Linux Libertine; Math: newtxmath; Titles: TeX Gyre Heros (sans)
\RequirePackage{libertine}
\RequirePackage[libertine]{newtxmath}
\RequirePackage[scale=0.96]{tgheros}

% ====== Interior color palette (cover defines its own) ======
\definecolor{Accent}      {HTML}{0F766E}
\definecolor{AccentDark}  {HTML}{0B4F4A}
\definecolor{AccentLight} {HTML}{D1FAE5}

\hypersetup{
	colorlinks=true,
	linkcolor=AccentDark,
	urlcolor=AccentDark,
	citecolor=AccentDark
}

% ====== Paragraphs & spacing ======
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\linespread{1.04}
\emergencystretch=2em
\sloppy

% ====== Headers/footers (oneside) ======
\setlength{\headheight}{26pt}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
\fancyhead[L]{\small\color{Accent}\nouppercase{\leftmark}}
\fancyhead[R]{\small\color{Accent}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{Accent}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{
	\fancyhf{}
	\fancyfoot[C]{\small\color{Accent}\thepage}
	\renewcommand{\headrulewidth}{0pt}
}

% ====== Chapter/Section titles (big chapter number) ======
\newcommand{\ChapterLabel}{\textsf{Capítulo}}
\newcommand{\ChapterBigNumber}{%
	\makebox[0pt][l]{%
		\hspace{-2.1cm}%
		{\color{Accent}\sffamily\bfseries\fontsize{66}{66}\selectfont \thechapter}%
	}%
}

\titleformat{\chapter}[display]
{\bfseries\sffamily\Huge\color{Accent}}
{\ChapterBigNumber \ChapterLabel}
{1ex}
{\vspace{0.5ex}\raggedleft}
[\vspace{0.75ex}\titlerule]

\titleformat{name=\chapter,numberless}[display]
{\bfseries\sffamily\Huge\color{Accent}}
{}{-4pt}{\raggedleft}
[\vspace{0.75ex}\titlerule]

\titlespacing*{\chapter}{0pt}{*2}{*2}

\titleformat{\section}
{\sffamily\Large\bfseries\color{Accent}}
{\thesection}{0.75em}{}
\titlespacing*{\section}{0pt}{*1}{0.5ex}

\titleformat{\subsection}
{\sffamily\large\bfseries\color{AccentDark}}
{\thesubsection}{0.75em}{}
\titlespacing*{\subsection}{0pt}{*1}{0.25ex}

% ====== Table of contents ======
\renewcommand{\cfttoctitlefont}{\sffamily\huge\bfseries\color{Accent}}
\renewcommand{\cftsecfont}{\sffamily}
\renewcommand{\cftsubsecfont}{\sffamily}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
