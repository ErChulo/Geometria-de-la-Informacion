% src/style-book.sty — elegant, consistent style (pdfLaTeX, oneside)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style-book}[2025/10/19 Elegant Book Style]

% ====== Base packages ======
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[spanish]{babel}
\RequirePackage{microtype}
\RequirePackage{amsmath,amssymb}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc,shadows.blur,backgrounds,babel,shapes.geometric}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage[table]{xcolor}
\RequirePackage{hyperref}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{tocloft}
\RequirePackage{enumitem}
\RequirePackage{amsthm}
\RequirePackage{listings}

% ====== Typefaces ======
% Text: Linux Libertine; Math: newtxmath; Titles: TeX Gyre Heros (sans)
\RequirePackage{libertine}
\RequirePackage[libertine]{newtxmath}
\RequirePackage[scale=0.96]{tgheros}

% ====== Interior color palette (cover defines its own) ======
\definecolor{Accent}      {HTML}{0F766E}
\definecolor{AccentDark}  {HTML}{0B4F4A}
\definecolor{AccentLight} {HTML}{D1FAE5}

\hypersetup{
	colorlinks=true,
	linkcolor=AccentDark,
	urlcolor=AccentDark,
	citecolor=AccentDark
}

% ====== Paragraphs & spacing ======
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\linespread{1.04}
\flushbottom
\fussy
\emergencystretch=2em

% ====== Headers/footers (oneside) ======
\setlength{\headheight}{26pt}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
\fancyhead[L]{\small\color{Accent}\nouppercase{\leftmark}}
\fancyhead[R]{\small\color{Accent}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{Accent}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{
	\fancyhf{}
	\fancyfoot[C]{\small\color{Accent}\thepage}
	\renewcommand{\headrulewidth}{0pt}
}

% ====== Chapter/Section titles (big chapter number) ======
\newcommand{\ChapterLabel}{\textsf{Capítulo}}

% Detecta recto (impar) / verso (par) y posiciona el número en el margen exterior
% Outer margin: 1in = 28.45275pt; Text width: 5in = 142.26378pt (letter, inner=1.75in, outer=1in)
% Number width: ~3.5cm = 99.58464pt (66pt digits, ~3 chars)
% Shift = -(outer_margin + gap + number_width) to go from text-left into outer margin
\newlength{\bigNumOuterGap}
\setlength{\bigNumOuterGap}{4pt}

\newcommand{\ChapterBigNumber}{%
	\ifodd\value{page}%
		% Recto (odd page): outer = right margin
		% Shift the number to the RIGHT of the text block
		\makebox[0pt][r]{%
			{\color{Accent}\sffamily\bfseries\fontsize{66}{66}\selectfont \thechapter}%
			\hspace{\bigNumOuterGap}%
		}%
	\else%
		% Verso (even page): outer = left margin
		% Shift the number to the LEFT of the text block
		\makebox[0pt][l]{%
			\hspace{-2.5cm}%
			{\color{Accent}\sffamily\bfseries\fontsize{66}{66}\selectfont \thechapter}%
		}%
	\fi%
}

\titleformat{\chapter}[display]
{\bfseries\sffamily\Huge\color{Accent}}
{\ChapterBigNumber \ChapterLabel}
{1ex}
{\vspace{0.5ex}\raggedleft}
[\vspace{0.75ex}\titlerule]

\titleformat{name=\chapter,numberless}[display]
{\bfseries\sffamily\Huge\color{Accent}}
{}{-4pt}{\raggedleft}
[\vspace{0.75ex}\titlerule]

\titlespacing*{\chapter}{0pt}{*2}{*2}

\titleformat{\section}
{\sffamily\Large\bfseries\color{Accent}}
{\thesection}{0.75em}{}
\titlespacing*{\section}{0pt}{*1}{0.5ex}

\titleformat{\subsection}
{\sffamily\large\bfseries\color{AccentDark}}
{\thesubsection}{0.75em}{}
\titlespacing*{\subsection}{0pt}{*1}{0.25ex}

% ====== Table of contents ======
\renewcommand{\cfttoctitlefont}{\sffamily\huge\bfseries\color{Accent}}
\renewcommand{\cftsecfont}{\sffamily}
\renewcommand{\cftsubsecfont}{\sffamily}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\setlength{\cftbeforetoctitleskip}{15pt}
\setlength{\cftaftertoctitleskip}{10pt}
\setlength{\cftbeforesecskip}{0.5em}
\setlength{\cftbeforesubsecskip}{0.3em}

% ====== Theorem-like environments ======
\theoremstyle{definition}
\newtheorem{definition}{Definición}[chapter]
\newtheorem{example}{Ejemplo}[chapter]

\theoremstyle{plain}
\newtheorem{theorem}{Teorema}[chapter]
\newtheorem{proposition}{Proposición}[chapter]
\newtheorem{corollary}{Corolario}[chapter]
\newtheorem{lemma}{Lema}[chapter]

\theoremstyle{remark}
\newtheorem{remark}{Observación}[chapter]

% ====== Code listings style ======
% Local sloppiness for code blocks (avoid overfull in long lines)
\lstset{
	basicstyle=\small\ttfamily,
	keywordstyle=\color{AccentDark}\bfseries,
	commentstyle=\color{Accent!60}\itshape,
	breaklines=true,
	columns=fullflexible,
	showstringspaces=false,
	frame=single,
	backgroundcolor=\color{AccentLight!20},
	numbers=left,
	numberstyle=\tiny\color{gray},
	numbersep=8pt,
	tabsize=4,
	xleftmargin=8pt,
	xrightmargin=8pt,
	framerule=0.5pt,
	rulecolor=\color{Accent!30},
	prebreak=\textbackslash,
	postbreak=\textbackslash
}

% Python-specific style
\lstdefinestyle{PythonStyle}{%
	basicstyle=\scriptsize\ttfamily,
	keywordstyle=\color{AccentDark}\bfseries,
	commentstyle=\color{Accent!60}\itshape,
	stringstyle=\color{Accent!80},
	backgroundcolor=\color{AccentLight!10},
	numbers=left,
	numberstyle=\tiny\color{gray},
	numbersep=8pt,
	tabsize=2,
	xleftmargin=4pt,
	xrightmargin=4pt,
	showstringspaces=false,
	columns=fullflexible,
	breaklines=true,
	framerule=0.5pt,
	rulecolor=\color{Accent!30},
	morekeywords={self,True,False,None,as,with,lambda,def,class,return,if,elif,else,for,while,in,not,and,or,is,import,from,try,except,finally,raise,yield,assert,break,continue,pass,del,global,nonlocal}
}
